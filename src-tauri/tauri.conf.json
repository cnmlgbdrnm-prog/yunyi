{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YunYi",
  "version": "0.4.0",
  "identifier": "com.vpnctl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "云驿",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "binaries/mihomo.exe",
      "binaries/tor/",
      "binaries/geo/country.mmdb",
      "binaries/geo/geoip.dat",
      "binaries/geo/geosite.dat"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2MDgzMjI4NTNEOTRFQTEKUldTaFR0bFRLRElJWnAyQ1REZ2QrQW9lVC9vSjRjenVFc24wWFg0SXdWYkxxY1llVWtmWlhQcDA=",
      "endpoints": [
        "https://github.com/cnmlgbdrnm-prog/vpn-ctl-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
